{
  "manifest_version": 3,
  "name": "YouTube Ambient Flow",
  "version": "1.0.0",
  "description": "Turn YouTube into an immersive, cinematic viewing experience with dynamic ambient colors.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["index.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-ambient-flow": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle Ambient Flow"
    },
    "toggle-focus-mode": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle Focus Mode"
    },
    "freeze-background": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Freeze or unfreeze background"
    }
  }
}
